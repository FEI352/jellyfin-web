[Unit]
Description=Rclone Mount Alist to /mnt/alist
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/bin/sh -c 'umount -l /mnt/alist 2>/dev/null || true'
ExecStart=/usr/bin/rclone mount alist:/ /mnt/alist \
    --config=/root/.config/rclone/rclone.conf \
    --allow-other \
    --vfs-cache-mode full \
    --vfs-cache-max-size 10G \
    --vfs-read-chunk-size 16M \
    --vfs-read-chunk-size-limit 256M \
    --buffer-size 32M \
    --dir-cache-time 12h \
    --read-only \
    --umask 000 \
    --timeout 30s \
    --contimeout 10s \
    --exclude "backups/**" \
    --exclude "_probe_dir/**" \
    --exclude "夸克精选壁纸/**" \
    --exclude "夸克网盘使用指南*" \
    --exclude "*.tmp" \
    --exclude "*.epub" \
    --exclude "*.pdf" \
    --exclude "*.doc" \
    --exclude "*.docx"
ExecStop=/bin/fusermount3 -u -z /mnt/alist
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
